---
// Fullscreen photo viewer. Works with every [data-gallery] grid on the page.
// Keys: ← → to move, Esc to close. On phones: swipe left/right.
---

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="lb-btn close" data-lb-close aria-label="Close">×</button>
  <button class="lb-btn prev" data-lb-prev aria-label="Previous photo">‹</button>
  <figure>
    <img data-lb-img alt="" />
    <figcaption data-lb-caption></figcaption>
  </figure>
  <button class="lb-btn next" data-lb-next aria-label="Next photo">›</button>
  <span class="count" data-lb-count></span>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--overlay);
    color: var(--text);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; animation: fade 0.25s ease; }
  figure { margin: 0; display: grid; justify-items: center; gap: 0.75rem; }
  img {
    max-width: calc(100vw - 8rem);
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
  }
  figcaption { font-size: 0.9rem; color: var(--muted); min-height: 1.2em; }
  .lb-btn {
    position: fixed;
    background: none;
    border: 0;
    color: inherit;
    font-size: 2.6rem;
    font-weight: 200;
    line-height: 1;
    width: 3.5rem;
    height: 3.5rem;
    cursor: pointer;
    opacity: 0.7;
  }
  .lb-btn:hover { opacity: 1; color: var(--accent); }
  .close { top: 0.75rem; right: 0.75rem; }
  .prev { left: 0.5rem; top: 50%; translate: 0 -50%; }
  .next { right: 0.5rem; top: 50%; translate: 0 -50%; }
  .count {
    position: fixed;
    top: 1.5rem;
    left: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  @keyframes fade { from { opacity: 0; } }
  @media (max-width: 640px) {
    img { max-width: 100vw; max-height: calc(100dvh - 6rem); box-shadow: none; }
    .prev, .next { top: auto; bottom: 0.5rem; translate: none; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dlg && !dlg.dataset.ready) {
    dlg.dataset.ready = '1';
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    let items: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${items.length}`;
      // Preload neighbours for instant navigation.
      [index + 1, index - 1].forEach((n) => {
        const next = items[(n + items.length) % items.length];
        if (next) new Image().src = next.href;
      });
    };

    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((grid) => {
      grid.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-index]');
        if (!a) return;
        e.preventDefault();
        items = [...grid.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
        show(Number(a.dataset.index));
        dlg.showModal();
      });
    });

    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    let startX = 0;
    dlg.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
