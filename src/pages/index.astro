---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { getGalleries, getHome, getSettings, withDetails } from '../lib/content';

const home = await getHome();
const s = await getSettings();
const galleries = (await getGalleries()).filter((g) => g.data.showOnHome);
---

<Base description={home.subheadline} ogImage={home.bannerImage} overlayHeader>
  <section class="banner">
    <Image
      src={home.bannerImage}
      alt={home.bannerAlt}
      widths={[800, 1400, 2000, 2800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      layout="none"
      class="banner-img"
    />
    <div class="banner-text">
      {s.tagline && <p class="eyebrow">{s.tagline}</p>}
      <h1>{home.headline}</h1>
      {home.subheadline && <p class="sub">{home.subheadline}</p>}
      {home.buttonText && <a class="btn" href="#portfolio">{home.buttonText}</a>}
    </div>
  </section>

  <section id="portfolio" class="section container">
    <h2 class="section-title">{home.galleriesHeading}</h2>
    <div class="cards">
      {
        galleries.map((g, i) => (
          <a class="card" href={`/${g.id}/`}>
            <Image
              src={g.data.cover}
              alt={g.data.coverAlt}
              widths={[600, 900, 1300, 1800]}
              sizes="(max-width: 760px) 100vw, 50vw"
              loading={i < 2 ? 'eager' : 'lazy'}
              layout="none"
            />
            <span class="card-label">
              <span class="card-title">{g.data.title}</span>
              <span class="card-cta">View gallery</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    home.featured.length > 0 && (
      <section class="section container">
        <h2 class="section-title">{home.featuredHeading}</h2>
        <GalleryGrid photos={withDetails(home.featured, [], 'Featured photograph')} rowHeight={380} id="featured" />
      </section>
    )
  }
</Base>

<style>
  .banner {
    position: relative;
    height: 100svh;
    min-height: 520px;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #fff;
    text-align: center;
  }
  .banner :global(.banner-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: zoom 14s ease-out both;
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.4));
  }
  .banner-text { position: relative; z-index: 1; padding: 1.5rem; max-width: 900px; }
  .banner-text .eyebrow { color: rgba(255, 255, 255, 0.85); }
  .sub { font-size: clamp(1rem, 1.6vw, 1.2rem); margin: 0 auto 2rem; max-width: 36em; }
  .banner .btn:hover { background: #fff; border-color: #fff; color: #111; }
  @keyframes zoom { from { transform: scale(1.08); } }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(10px, 1.5vw, 20px);
  }
  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-alt);
    color: #fff;
    text-decoration: none;
  }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%, rgba(0, 0, 0, 0.5));
    transition: background-color 0.4s;
  }
  .card:hover :global(img) { transform: scale(1.04); }
  .card:hover::after { background-color: rgba(0, 0, 0, 0.12); }
  .card-label {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    display: grid;
    gap: 0.3rem;
  }
  .card-title { font-family: var(--font-heading), serif; font-size: clamp(1.8rem, 3.2vw, 2.8rem); line-height: 1.1; }
  .card-cta { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.85; }

  @media (max-width: 760px) {
    .cards { grid-template-columns: 1fr; }
    .card { aspect-ratio: 4 / 3; }
  }
</style>
