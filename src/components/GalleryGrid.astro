---
// A "justified" photo grid: rows fill the full width, each photo keeps its shape,
// and photos stay in the order you set in the admin panel (left to right).
// Clicking a photo opens it fullscreen in the lightbox.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Photo { image: ImageMetadata; alt?: string; caption?: string }
interface Props { photos: Photo[]; rowHeight?: number; id?: string }
const { photos, rowHeight = 360, id = 'gallery' } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({ src: p.image, width: Math.min(p.image.width, 2400), format: 'webp' });
    return { ...p, full: full.src, ratio: p.image.width / p.image.height };
  }),
);
---

<div class="grid" data-gallery={id} style={`--row:${rowHeight}px`}>
  {
    items.map((p, i) => (
      <a
        class="item"
        href={p.full}
        data-index={i}
        data-caption={p.caption || ''}
        style={`--r:${p.ratio.toFixed(4)}`}
      >
        <Image
          src={p.image}
          alt={p.alt ?? ''}
          widths={[480, 800, 1200, 1600]}
          sizes={`(max-width: 640px) 100vw, ${Math.round(rowHeight * p.ratio * 1.1)}px`}
          loading={i < 4 ? 'eager' : 'lazy'}
          layout="none"
        />
        {p.caption && <span class="caption">{p.caption}</span>}
      </a>
    ))
  }
  <span class="filler" aria-hidden="true"></span>
</div>
<Lightbox />

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .item {
    position: relative;
    flex: var(--r) 1 calc(var(--row) * var(--r));
    aspect-ratio: var(--r);
    overflow: hidden;
    background: var(--bg-alt);
    cursor: zoom-in;
  }
  .item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease, opacity 0.4s;
  }
  .item:hover :global(img) { transform: scale(1.03); }
  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2rem 1rem 0.75rem;
    color: #fff;
    font-size: 0.85rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    opacity: 0;
    transition: opacity 0.3s;
  }
  .item:hover .caption { opacity: 1; }
  .filler { flex: 10 1 0; }

  @media (max-width: 640px) {
    .item { flex-basis: 100%; }
    .filler { display: none; }
  }
</style>
