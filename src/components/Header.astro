---
import { getGalleries, getSettings } from '../lib/content';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const s = await getSettings();
const galleries = await getGalleries();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ...galleries.map((g) => ({ href: `/${g.id}`, label: g.data.title })),
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar container">
    <a class="logo" href="/">{s.siteName}</a>
    <button class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="nav" data-nav>
      {
        links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      {
        s.showThemeToggle && (
          <button class="theme-btn" type="button" data-theme-btn aria-label="Toggle light or dark mode">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" />
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .site-header.overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
    border-color: transparent;
    color: #fff;
  }
  .site-header.overlay.scrolled,
  .site-header.overlay.open {
    background: var(--bg);
    border-color: var(--line);
    color: var(--text);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 76px;
  }
  .logo {
    font-family: var(--font-heading), serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2.25rem); }
  .nav a {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current='page'] { border-color: var(--accent); }
  .theme-btn {
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0.25rem;
  }
  .menu-btn {
    display: none;
    background: none;
    border: 0;
    color: inherit;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 24px;
    height: 1px;
    background: currentColor;
    margin: auto;
    transition: transform 0.25s;
    content: '';
  }
  .burger::before { transform: translateY(-7px); }
  .burger::after { transform: translateY(6px); }
  .open .burger { background: transparent; }
  .open .burger::before { transform: rotate(45deg); }
  .open .burger::after { transform: translateY(-1px) rotate(-45deg); }

  @media (max-width: 860px) {
    .menu-btn { display: block; }
    .nav {
      position: fixed;
      inset: 76px 0 0;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      background: var(--bg);
      color: var(--text);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, visibility 0.25s;
    }
    .nav a { font-size: 1rem; }
    .open .nav { opacity: 1; visibility: visible; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  btn.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.querySelector('[data-theme-btn]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
